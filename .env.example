# StayEase Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (Unit 4)
MONGODB_URI=mongodb://127.0.0.1:27017/hotelDB

# Hotel Configuration
HOTEL_NAME="StayEase Hotel & Suites"
HOTEL_ADDRESS="Plot 42, Knowledge City, Bangalore, Karnataka, India"
HOTEL_CONTACT="+91 80 4912 3456"
HOTEL_EMAIL="reception@stayease.hotel"

# Business Constants
TAX_RATE_GST=0.18
CLEANING_DURATION_HOURS=2

# Security & Upload Configuration (Unit 3 - Akul Agarwal)
MAX_FILE_SIZE_BYTES=5242880
ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png"

# Email Configuration (Nodemailer - Unit 3 - Akul Agarwal)
# In development/test, Nodemailer generates Ethereal test account or simulated console logs
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="StayEase Hotel <no-reply@stayease.hotel>"
